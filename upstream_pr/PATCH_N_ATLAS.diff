index 0000000..8a4e321
--- /dev/null
+++ b/tokenization_natlas.py
@@ -0,0 +1,35 @@
+# Native Sovereign Pre-Tokenizer Hook for N-ATLaS
+import unicodedata
+import re
+
+class NATLaSPreTokenizer:
+    """
+    Canonical diacritic normalizer for Yoruba, Hausa, and Igbo.
+    Prevents Llama-3 BPE multi-byte fallback on combining marks.
+    """
+    CANONICAL_AFRICAN_GLYPHS = {
+        "e\u0323\u0301": "ẹ́", "e\u0323\u0300": "ẹ̀",
+        "o\u0323\u0301": "ọ́", "o\u0323\u0300": "ọ̀",
+        "b\u0313": "ɓ", "d\u0313": "ɗ", "k\u0313": "ƙ", "y\u0313": "ƴ",
+        "i\u0323": "ị", "o\u0323": "ọ", "u\u0323": "ụ"
+    }
+
+    def __call__(self, text: str) -> str:
+        for decomposed, precomposed in self.CANONICAL_AFRICAN_GLYPHS.items():
+            if decomposed in text:
+                text = text.replace(decomposed, precomposed)
+        return unicodedata.normalize("NFC", text)
